<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns:t="sap.ui.table">
	<t:Table id="generalTable" rows="{ path: 'filtered>/', sorter: { path: 'FhFormat', descending: true }}" selectionMode="None">
		<t:Column width="50px">
			<Label/>
			<t:template>
				<HBox >
					<Button type="Transparent" press="onSee" icon="sap-icon://show"/>
				</HBox>
			</t:template>
		</t:Column>
		<t:columns>
			<t:Column sortProperty="FhFormat">
				<Label text="{i18n>dateTime}"/>
				<t:template>
					<!--<Text text="{filtered>FhFormat}"/>-->
					<DatePicker change="handleTableChanges" value="{filtered>FhFormat}"/>
				</t:template>
			</t:Column>
			<t:Column width="95px" sortProperty="LugarFormat" filterProperty="LugarFormat">
				<Label text="{i18n>place}"/>
				<t:template>
					<!--<Text text="{filtered>LugarFormat}"/>-->
					<ComboBox selectionChange="handleTableChanges" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }"
						selectedKey="{filtered>Lugar}">
						<core:Item key="{Estaciones>Estacion}" text="{Estaciones>Codigo}"/>
					</ComboBox>
				</t:template>
			</t:Column>
			<t:Column width="95px" filterProperty="Equipo">
				<Label text="{i18n>team}"/>
				<t:template>
					<Text text="{filtered>Equipo}"/>
				</t:template>
			</t:Column>
			<t:Column sortProperty="Tiponovedad" filterProperty="Tiponovedad">
				<Label text="{i18n>noveltyType}"/>
				<t:template>
					<Text text="{filtered>Tiponovedad}"/>
				</t:template>
			</t:Column>
			<t:Column width="320px">
				<Label text="{i18n>novelty}"/>
				<t:template>
					<Text text="{filtered>Novedad}"/>
				</t:template>
			</t:Column>
			<t:Column sortProperty="Creado_Por" filterProperty="Creado_Por">
				<Label text="{i18n>operator}"/>
				<t:template>
					<Text text="{path:'filtered>Creado_Por', formatter: '.formatter.uppercase'}"/>
				</t:template>
			</t:Column>
			<t:Column width="130px">
				<Label/>
				<t:template>
					<HBox justifyContent="SpaceAround" wrap="Wrap">
						<Button type="Transparent" press="saveChanges" enabled="false" icon="sap-icon://accept"/>
						<Button type="Transparent" press="onEdit" icon="sap-icon://edit"/>
						<Button type="Transparent" press='onDelete' icon="sap-icon://delete"/>
					</HBox>
				</t:template>
			</t:Column>
		</t:columns>
	</t:Table>
</core:FragmentDefinition>