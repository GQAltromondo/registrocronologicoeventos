<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:layout="sap.ui.layout"
	xmlns:core="sap.ui.core">
	<Dialog id="formProgramadas" title="Tareas Programadas" titleAlignment="Start">
		<content>
			<FlexBox class="sapUiSmallMargin containerDialog" direction="Column">
				<HBox width="100%">
					<VBox width="50%" class="FlexForm">
						<HBox class="HBoxContainer">
							<HBox width="50%" justifyContent="SpaceBetween" alignItems="Center">
								<Label text="{i18n>estacion}:" class="sapUiTinyMarginEnd"/>
								<HBox>
									<ComboBox id="cmbLugarId" width="80px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Tplnr}"
										items="{ path: 'Estaciones>/Estaciones', templateShareable: true }">
										<core:Item key="{Estaciones>Codigo}" text="{Estaciones>Codigo}"/>
									</ComboBox>
									<ComboBox id="cmbLugar" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Tplnr}"
										items="{ path: 'Estaciones>/Estaciones', templateShareable: true }">
										<core:Item key="{Estaciones>Codigo}" text="{Estaciones>Descripcion}"/>
									</ComboBox>
								</HBox>
							</HBox>
							<HBox width="50%" justifyContent="End" alignItems="Center">
								<Label text="Referencia" class="sapUiTinyMarginEnd"/>
								<Input enabled="false" value="{NovedadesFormJsonModel>/IdNovedad}" width="150px"/>
							</HBox>
						</HBox>
						<HBox class="HBoxContainer">
							<HBox width="50%" alignItems="Center">
								<Label text="Equipo CAMMESA:" wrapping="true" class="sapUiMediumMarginEnd"/>
								<HBox>
									<ComboBox id="cmbEquipoId" width="80px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Equnr}"
										items="{ path: 'TipoModel>/Tipo', templateShareable: true }">
										<core:Item key="{TipoModel>Tipo}" text="{TipoModel>Tipo}"/>
									</ComboBox>
									<ComboBox id="cmbEquipo" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Equnr}"
										items="{ path: 'TipoModel>/Tipo', templateShareable: true }">
										<core:ListItem key="{TipoModel>Tipo}" text="{TipoModel>Descripcion}"/>
									</ComboBox>
								</HBox>
							</HBox>
							<HBox width="50%" alignItems="Center">
								<Label text="LLTT asociadas:"/>
								<HBox>
									<ComboBox id="cmbNoveltiesId" width="90px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/CodNovedad}"
										items="{ path: 'Novedades>/novs', templateShareable: true }">
										<core:Item key="{Novedades>Codigo}" text="{Novedades>Codigo}"/>
									</ComboBox>
									<ComboBox id="cmbNovelties" width="120px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/CodNovedad}"
										items="{ path: 'Novedades>/novs', templateShareable: true }">
										<core:Item key="{Novedades>Codigo}" text="{Novedades>Descripcion}"/>
									</ComboBox>
								</HBox>
							</HBox>
						</HBox>
						<HBox class="HBoxContainer">
							<HBox width="50%" alignItems="Center">
								<Label text="Se descargo desde" wrapping="true" class="sapUiTinyMarginEnd"/>
								<ComboBox id="cmbExtId" selectionChange=".onSelectionChange" busy="{MotivosJsonModel>Busy}"
									selectedKey="{NovedadesFormJsonModel>/CodMotivo}" items="{ path: 'MotivosJsonModel>/', templateShareable: true }">
									<core:Item key="{MotivosJsonModel>CodigoMotivo}" text="{MotivosJsonModel>CodigoMotivo}"/>
								</ComboBox>
							</HBox>
							<HBox width="50%" justifyContent="SpaceBetween" alignItems="Center">
								<Label text="Fecha/Hora"/>
								<DateTimePicker
									value="{ 'path': 'NovedadesFormJsonModel>/InicioNov', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
							</HBox>
						</HBox>
						<HBox class="HBoxContainer">
							<HBox width="50%" alignItems="Center">
								<Label text="Fuera de Servicio desde" wrapping="true" class="sapUiTinyMarginEnd"/>
								<ComboBox id="cmbFueraId" selectionChange=".onSelectionChange" busy="{MotivosJsonModel>Busy}"
									selectedKey="{NovedadesFormJsonModel>/CodMotivo}" items="{ path: 'MotivosJsonModel>/', templateShareable: true }">
									<core:Item key="{MotivosJsonModel>CodigoMotivo}" text="{MotivosJsonModel>CodigoMotivo}"/>
								</ComboBox>
							</HBox>
							<HBox width="50%" justifyContent="SpaceBetween" alignItems="Center">
								<Label text="Fecha/Hora"/>
								<DateTimePicker
									value="{ 'path': 'NovedadesFormJsonModel>/InicioNov', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
							</HBox>
						</HBox>
						<HBox class="HBoxContainer">
							<HBox width="50%">
								<Label text="Equipo E/S a través de" wrapping="true"/>
								<VBox>
									<CheckBox text="Barra de transferencia"/>
									<CheckBox text="Seleccionador de paso"/>
									<CheckBox text="Acoplador"/>
								</VBox>
							</HBox>
							<VBox>
								<HBox class="HBoxContainer">
									<Label text="Interruptor F/S" class="sapUiTinyMargin"/>
									<Input/>
								</HBox>
								<HBox class="HBoxContainer">
									<Label text="Fecha/Hora" class="sapUiTinyMargin"/>
									<DatePicker/>
								</HBox>
							</VBox>
						</HBox>
					</VBox>
					<VBox width="50%" class="FlexForm">
						<Input value="Normalizacion de la instalación" enabled="false"/>
						<HBox class="HBoxContainer">
							<HBox class="HBoxWrapper">
								<Label text="Se Energizó desde" wrapping="true" class="sapUiTinyMarginEnd"/>
								<ComboBox selectionChange=".onSelectionChange" busy="{MotivosJsonModel>Busy}" selectedKey="{NovedadesFormJsonModel>/CodMotivo}"
									items="{ path: 'MotivosJsonModel>/', templateShareable: true }">
									<core:Item key="{MotivosJsonModel>CodigoMotivo}" text="{MotivosJsonModel>CodigoMotivo}"/>
								</ComboBox>
							</HBox>
							<HBox class="HBoxWrapper">
								<Label text="Fecha/Hora"/>
								<DateTimePicker
									value="{ 'path': 'NovedadesFormJsonModel>/InicioNov', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
							</HBox>
						</HBox>
						<HBox class="HBoxContainer">
							<HBox class="HBoxWrapper">
								<Label text="En Servicio (E/S)" wrapping="true" class="sapUiTinyMarginEnd"/>
								<ComboBox selectionChange=".onSelectionChange" busy="{MotivosJsonModel>Busy}" selectedKey="{NovedadesFormJsonModel>/CodMotivo}"
									items="{ path: 'MotivosJsonModel>/', templateShareable: true }">
									<core:Item key="{MotivosJsonModel>CodigoMotivo}" text="{MotivosJsonModel>CodigoMotivo}"/>
								</ComboBox>
							</HBox>
							<HBox class="HBoxWrapper">
								<Label text="Fecha/Hora"/>
								<DateTimePicker
									value="{ 'path': 'NovedadesFormJsonModel>/InicioNov', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
							</HBox>
						</HBox>
						<HBox class="HBoxContainer">
							<HBox class="HBoxWrapper">
								<Label text="E/S a través de Interruptor propio" wrapping="true" class="sapUiTinyMarginEnd"/>
								<ComboBox selectionChange=".onSelectionChange" busy="{MotivosJsonModel>Busy}" selectedKey="{NovedadesFormJsonModel>/CodMotivo}"
									items="{ path: 'MotivosJsonModel>/', templateShareable: true }">
									<core:Item key="{MotivosJsonModel>CodigoMotivo}" text="{MotivosJsonModel>CodigoMotivo}"/>
								</ComboBox>
							</HBox>
							<HBox class="HBoxWrapper">
								<Label text="Fecha/Hora"/>
								<DateTimePicker
									value="{ 'path': 'NovedadesFormJsonModel>/InicioNov', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
							</HBox>
						</HBox>
						<IconTabBar expandable="false" backgroundDesign="Transparent" headerBackgroundDesign="Transparent">
							<items>
								<IconTabFilter text="Parte de indisponibilidades" design="Horizontal" showAll="true">
									<VBox class="HBoxContainer">
										<HBox width="100%" alignItems="Center" justifyContent="End">
											<Label text="Fecha/Hora Disponible" class="sapUiTinyMarginEnd"/>
											<DatePicker/>
										</HBox>
										<VBox width="100%">
											<Label text="Comentarios"/>
											<TextArea width="100%"/>
										</VBox>
									</VBox>
									<HBox class="HBoxContainer">
										<VBox width="100%">
											<Label text="Se informó a Empresa"/>
											<Select width="100%"/>
										</VBox>
										<VBox width="100%">
											<Label text="Se informó al Técnico"/>
											<Select width="100%"/>
										</VBox>
									</HBox>
								</IconTabFilter>
							</items>
						</IconTabBar>
					</VBox>
				</HBox>
				<HBox width="100%">
					<VBox width="50%" class="FlexForm">
						<IconTabBar expandable="false" backgroundDesign="Transparent" headerBackgroundDesign="Transparent">
							<items>
								<IconTabFilter text="Parte de Indisponibilidades" design="Horizontal" showAll="true">
