									</VBox>
									<VBox width="100%">
										<Label text="Comentarios" class="sapUiTinyMarginEnd"/>
										<TextArea width="100%"/>
									</VBox>
								</IconTabFilter>
							</items>
						</IconTabBar>
					</VBox>
				</HBox>
