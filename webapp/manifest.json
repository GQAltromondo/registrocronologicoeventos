{
  "_version": "1.12.0",
  "sap.app": {
    "id": "transener.registrocronologicoeventos",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.6"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "sourceTemplate": {
      "id": "servicecatalog.connectivityComponentForManifest",
      "version": "0.0.0",
      "toolsId": "5ea4176d-8a37-4709-a5ba-ca892a16c13d"
    },
    "dataSources": {
      "Z_SCP_LIBRO_GUARDIAS_SRV": {
        "uri": "/sap/opu/odata/sap/Z_SCP_LIBRO_GUARDIAS_SRV/",
        "type": "OData",
        "settings": {
          "localUri": "localService/metadata.xml"
        }
      },
      "Z_SCP_OPERACIONES_SRV": {
        "uri": "/sap/opu/odata/sap/Z_SCP_OPERACIONES_SRV/",
        "type": "OData",
        "settings": {
          "localUri": "localService/metadata.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "registrocronologicoeventos-view": {
          "semanticObject": "registrocronologicoeventos",
          "action": "view",
          "title": "{{flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "rootView": {
      "viewName": "transener.registrocronologicoeventos.view.Main",
      "type": "XML",
      "async": true,
      "id": "Main"
    },
    "dependencies": {
      "minUI5Version": "1.98.0",
      "libs": {
        "sap.ui.layout": {},
        "sap.ui.core": {},
        "sap.m": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "transener.registrocronologicoeventos.i18n.i18n"
        }
      },
      "LGuardias": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "settings": {
          "defaultOperationMode": "Server",
          "defaultBindingMode": "OneWay",
          "defaultCountMode": "Request",
          "useBatch": false,
          "defaultUpdateMethod": "PUT"
        },
        "dataSource": "Z_SCP_LIBRO_GUARDIAS_SRV",
        "preload": true
      },
      "Operaciones": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "settings": {
          "defaultOperationMode": "Server",
          "defaultBindingMode": "OneWay",
          "defaultCountMode": "Request",
          "useBatch": false
        },
        "dataSource": "Z_SCP_OPERACIONES_SRV",
        "preload": true
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "path": "transener.registrocronologicoeventos.view",
        "type": "View",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": "",
          "target": [
            "Main"
          ]
        },
        {
          "pattern": "perturbaciones/{mode}/{idNovedad}/{empresa}",
          "name": "Perturbaciones",
          "target": "Perturbaciones"
        },
        {
          "name": "Programadas",
          "pattern": "programadas/{mode}",
          "target": "Programadas"
        },
        {
          "name": "Novedades",
          "pattern": "novedades/{mode}",
          "target": "Novedades"
        },
         {
          "name": "Consecuentes",
          "pattern": "consecuentes/{mode}/{idNovedad}/{empresa}",
          "target": "Consecuentes"
        }
      ],
      "targets": {
        "Main": {
          "type": "View",
          "name": "Main",
          "viewLevel": 1
        },
        "Perturbaciones": {
          "type": "View",
          "name": "Perturbaciones",
          "viewLevel": 2
        },
        "Programadas": {
          "type": "View",
          "name": "Programadas",
          "viewLevel": 2
        },
        "Novedades": {
          "type": "View",
          "name": "Novedades",
          "viewLevel": 2
        },
         "Consecuentes": {
          "type": "View",
          "name": "Consecuentes",
          "viewLevel": 2
        }
      }
    }
  },
  "sap.platform.hcp": {
    "uri": "webapp",
    "_version": "1.1.0"
  },
  "sap.cloud": {
    "public": true,
    "service": "transenerregistrocronologicoeventos"
  }
}