<mvc:View controllerName="transener.registrocronologicoeventos.controller.Consecuentes"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table">

	<Page id="ConsecuentesPage" title="Consecuentes" titleAlignment="Center" enableScrolling="true" showNavButton="true" navButtonPress="onNavBack">

		<content>
			<FlexBox direction="Column" class="wrapper">
				<VBox class="container">
					<HBox class="container">
						<HBox alignItems="Center" class="container" width="40%">
							<Label class="sapUiMediumMarginBeginEnd" text="Ubicacion"></Label>
							<ComboBox selectionChange=".onUbicacionChange" selectedKey="{ConsecuentesFormJsonModel/Tplnr}" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }" class="sapUiSmallMarginEnd">
								<core:ListItem key="{Estaciones>Codigo}" text="{Estaciones>Descripcion}" additionalText="{Estaciones>Codigo}" />
							</ComboBox>
						</HBox>
						<HBox alignItems="Center" class="container" width="40%">
							<Label class="sapUiMediumMarginBeginEnd" text="Referencia" />
							<Input value="{NovedadesFormJsonModel>/IdNovedad}" editable="false"/>
						</HBox>
					</HBox>
					<HBox justifyContent="SpaceBetween">
						<HBox alignItems="Center" class="container" width="40%">
							<Label class="sapUiMediumMarginBeginEnd" text="Equipo CAMMESA"></Label>
						     <ComboBox selectedKey="{ConsecuentesFormJsonModel>/Equnr}" valueState="{ConsecuentesFormJsonModel>/EqunrState}" class="cmbMD" valueStateText="{ConsecuentesFormJsonModel>/EqunrStateMessage}" items="{ path: 'EquiposModel>/Equipos', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}">
                                <core:ListItem key="{EquiposModel>CodigoEquipo}" text="{EquiposModel>CodigoEquipo} - {EquiposModel>DescEquipo}" />
                            </ComboBox>
						</HBox>
						<HBox alignItems="Center" class="container" width="40%">
							<Label class="sapUiMediumMarginBeginEnd" text="LLTT asociadas"></Label>
							<Input  value="{LicencesListJsonModel/Licences>/0}"/>
						</HBox>
					</HBox>

				</VBox>
				<HBox class="container topBorder">
					<HBox alignItems="Center" justifyContent="SpaceBetween" width="40%">
						<Label class="sapUiMediumMarginBeginEnd" text="Indisponible desde"></Label>

						<DateTimePicker  value="{ 'path': 'ConsecuentesFormJsonModel>/EntIndis', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
					</HBox>
					<HBox alignItems="Center" justifyContent="SpaceBetween" width="40%">
						<Label class="sapUiMediumMarginBeginEnd" text="Disponible desde"></Label>
						<DateTimePicker  value="{ 'path': 'ConsecuentesFormJsonModel>/EntDispo', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
					</HBox>
				</HBox>

				<VBox class="container topBorder">
					<HBox class="container">
						<HBox alignItems="Center">
							<Label class="sapUiMediumMarginBeginEnd" text="Motivo"></Label>
						   <ComboBox selectionChange=".onMotivoChange" busy="{MotivosJsonModel>Busy}" selectedKey="{ConsecuentesFormJsonModel>/CodMotivo}" valueState="{ConsecuentesFormJsonModel>/CodMotivoState}" valueStateText="{ConsecuentesFormJsonModel>/CodMotivoStateMessage}" items="{ path: 'MotivosJsonModel>/', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}">
                                <core:ListItem key="{MotivosJsonModel>CodigoMotivo}" text="{MotivosJsonModel>DescMotivo}"/>
                            </ComboBox>
						</HBox>
						<HBox alignItems="Center">
							<Label class="sapUiMediumMarginBeginEnd" text="Causa"></Label>
						  <ComboBox selectionChange=".onSelectionChange" selectedKey="{ConsecuentesFormJsonModel>/CodCausa}" valueState="{ConsecuentesFormJsonModel>/CodCausaState}" valueStateText="{ConsecuentesFormJsonModel>/CodCausaStateMessage}" items="{ path: 'CausasJsonModel>/Causas', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}">
                                <core:ListItem key="{CausasJsonModel>CodigoCausa}" text="{CausasJsonModel>DescCausa}" />
                            </ComboBox>
						</HBox>
					
						<HBox alignItems="Center">
							<Label class="sapUiMediumMarginBeginEnd" text="Vinculado y sin tensíon"></Label>
							<CheckBox selected="{ConsecuentesFormJsonModel>/Vinculadost}"/>
						</HBox>
					</HBox>
					<VBox class="container">
						<VBox >
							<Label text="Comentarios"></Label>
							<TextArea  value="{ConsecuentesFormJsonModel>/Observ}" width="100%"/>
							<HBox alignItems="Center">
								<Label text="La indisponibilidad se informa a CAMMESA" class="sapUiSmallMarginEnd"/>
								<CheckBox selected="{CammesaFormJsonModel>/InformaCammesa}" text="SI"></CheckBox>
							</HBox>
						</VBox>
						<VBox >
							<Label text="Comentarios Generales"></Label>
							<TextArea  value="{CammesaFormJsonModel>/Texto}" width="100%"/>
						</VBox>
					</VBox>
				</VBox>
				<HBox justifyContent="End" >
					<Button text="Agregar" class="sapUiSmallMargin" press=".onAddConsecuente" type="Emphasized"/>
				</HBox>
				<t:Table id="consecuentes" rows="{ path: 'ConsequentListJsonModel>/Consequents', sorter: { path: 'FhFormat', descending: true }}" selectionMode="None" alternateRowColors="true">
					<t:Column width='200px'>
						<Label text="{i18n>CammesaEq}"/>
						<t:template>
						<Text text="{ConsequentListJsonModel>Equnr}"/>
						</t:template>
					</t:Column>
					<t:Column width='200px'>
						<Label text="{i18n>fs}"/>
						<t:template>	
							<DateTimePicker change="handleTableChanges" value="{ 'path': 'ConsequentListJsonModel>InicioNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
						</t:template>
					</t:Column>
					<t:Column width='200px'>
						<Label text="{i18n>indisDesde}"/>
						<t:template>				
							<DateTimePicker change="handleTableChanges" value="{ 'path': 'ConsequentListJsonModel>EntIndis', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
						</t:template>
					</t:Column>
					<t:Column width='150px'>
						<Label text="{i18n>es}"/>
						<t:template>
							<DateTimePicker change="handleTableChanges" value="{ 'path': 'ConsequentListJsonModel>EntServicio', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
						</t:template>
					</t:Column>
					<t:Column width='150px'>
						<Label text="{i18n>dispDesde}"/>
						<t:template>
							<DateTimePicker change="handleTableChanges" value="{ 'path': 'ConsequentListJsonModel>EntDispo', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
							
						</t:template>
					</t:Column>
					<t:Column width='250px'>
						<Label text="{i18n>comentarios}"/>
						<t:template>
							<Text text="{ConsequentListJsonModel>Observ}"/>
						</t:template>
					</t:Column>
					<t:Column>
						<Label text="{i18n>infCammesa}"/>
						<t:template>
							<Text text="{ConsequentListJsonModel>InformaCammesa}"/>
						</t:template>
					</t:Column>
					<t:Column width="180px">
						<Label />
						<t:template>
							<HBox wrap="Wrap">
								<Button type="Transparent" press="onSee" icon="sap-icon://show"/>
								<Button type="Transparent" press="saveChanges" enabled="false" icon="sap-icon://save"/>
								<Button type="Transparent" press="onEditNove" icon="sap-icon://edit"/>
								<Button type="Transparent" press='onDelete' icon="sap-icon://delete"/>
							</HBox>
						</t:template>
					</t:Column>
				</t:Table>
			</FlexBox>
		</content>

		<footer>
			<OverflowToolbar>
				<ToolbarSpacer/>
				<Button type="Emphasized" text="{ parts: [ 'editModel>/editableMode' ], formatter: '.formatter.formatName' }" press="onSaveNovedad"/>
				<Button text="Cancelar" press="onNavBack"/>
			</OverflowToolbar>
		</footer>

	</Page>
</mvc:View>
