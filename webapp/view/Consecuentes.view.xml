<mvc:View controllerName="transener.registrocronologicoeventos.controller.Consecuentes"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table">

	<Page id="ConsecuentesPage" title="Consecuentes" titleAlignment="Center" enableScrolling="true" showNavButton="true" navButtonPress="onNavBack">

		<content>
			<FlexBox direction="Column" class="wrapper">
				<VBox class="container">
					<HBox class="container">
						<HBox alignItems="Center" class="container" width="40%">
							<Label class="sapUiMediumMarginBeginEnd" text="Ubicacion"></Label>
							<ComboBox selectionChange=".onUbicacionChange" selectedKey="{ConsecuentesFormJsonModel/Tplnr}" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }" class="sapUiSmallMarginEnd">
								<core:ListItem key="{Estaciones>Codigo}" text="{Estaciones>Descripcion}" additionalText="{Estaciones>Codigo}" />
							</ComboBox>
						</HBox>
						<HBox alignItems="Center" class="container" width="40%">
							<Label class="sapUiMediumMarginBeginEnd" text="Referencia"></Label>
							<Input ></Input>
						</HBox>
					</HBox>
					<HBox justifyContent="SpaceBetween">
						<HBox alignItems="Center" class="container" width="40%">
							<Label class="sapUiMediumMarginBeginEnd" text="Equipo CAMMESA"></Label>
							<ComboBox ></ComboBox>
						</HBox>
						<HBox alignItems="Center" class="container" width="40%">
							<Label class="sapUiMediumMarginBeginEnd" text="LLTT asociadas"></Label>
							<Input ></Input>
						</HBox>
					</HBox>

				</VBox>
				<HBox class="container topBorder">
					<HBox alignItems="Center" justifyContent="SpaceBetween" width="40%">
						<Label class="sapUiMediumMarginBeginEnd" text="Indisponible desde"></Label>
						<DatePicker/>
					</HBox>
					<HBox alignItems="Center" justifyContent="SpaceBetween" width="40%">
						<Label class="sapUiMediumMarginBeginEnd" text="Disponible desde"></Label>
						<DatePicker/>
					</HBox>
				</HBox>

				<VBox class="container topBorder">
					<HBox class="container">
						<HBox alignItems="Center">
							<Label class="sapUiMediumMarginBeginEnd" text="Causa"></Label>
							<ComboBox ></ComboBox>
						</HBox>
						<HBox alignItems="Center">
							<Label class="sapUiMediumMarginBeginEnd" text="Motivo"></Label>
							<ComboBox ></ComboBox>
						</HBox>
						<HBox alignItems="Center">
							<Label class="sapUiMediumMarginBeginEnd" text="Vinculado y sin tensíon"></Label>
							<CheckBox/>
						</HBox>
					</HBox>
					<VBox class="container">
						<VBox >
							<Label text="Comentarios"></Label>
							<TextArea width="100%"/>
							<HBox alignItems="Center">
								<Label text="La indisponibilidad se informa a CAMMESA" class="sapUiSmallMarginEnd"/>
								<CheckBox text="SI"></CheckBox>
							</HBox>
						</VBox>
						<VBox >
							<Label text="Comentarios Generales"></Label>
							<TextArea width="100%"/>
						</VBox>
					</VBox>
				</VBox>
				<HBox justifyContent="End" >
					<Button text="Agregar" class="sapUiSmallMargin"/>
				</HBox>
				<t:Table id="consecuentes" rows="{ path: 'ConsequentListJsonModel>/Consequents', sorter: { path: 'FhFormat', descending: true }}" selectionMode="None" alternateRowColors="true">
					<t:Column width='200px'>
						<Label text="{i18n>CammesaEq}"/>
						<t:template>
							<!--<Text text="{parts: [{path: 'ConsequentListJsonModel>InicioNove'}], formatter: '.formatter.formatDateWithoutGMT'}"/>-->
							<DateTimePicker change="handleTableChanges" value="{ 'path': 'ConsequentListJsonModel>InicioNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
						</t:template>
					</t:Column>
					<t:Column width='200px'>
						<Label text="{i18n>fs}"/>
						<t:template>
							<!--<Text text="{parts: [{path: 'ConsequentListJsonModel>FechaFinNove'}], formatter: '.formatter.formatDateWithoutGMT'}"/>-->
							<DateTimePicker change="handleTableChanges" value="{ 'path': 'ConsequentListJsonModel>FechaFinNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
						</t:template>
					</t:Column>
					<t:Column width='200px'>
						<Label text="{i18n>indisDesde}"/>
						<t:template>
							<!--<Text text="{ConsequentListJsonModel>Tplnr}"/>-->
							<ComboBox selectionChange="handleTableChanges" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }" selectedKey="{ConsequentListJsonModel>Tplnr}">
								<core:Item key="{Estaciones>Codigo}" text="{Estaciones>Codigo}"/>
							</ComboBox>
						</t:template>
					</t:Column>
					<t:Column width='150px'>
						<Label text="{i18n>es}"/>
						<t:template>
							<Text text="{ConsequentListJsonModel>Equnr}"/>
						</t:template>
					</t:Column>
					<t:Column width='150px'>
						<Label text="{i18n>dispDesde}"/>
						<t:template>
							<Text text="{parts:[{path:'ConsequentListJsonModel>CodNovedad'}],formatter:'.formatter.novedadType'}"/>
						</t:template>
					</t:Column>
					<t:Column width='250px'>
						<Label text="{i18n>comentarios}"/>
						<t:template>
							<Text text="{ConsequentListJsonModel>CodUbFalla}"/>
						</t:template>
					</t:Column>
					<t:Column>
						<Label text="{i18n>infCammesa}"/>
						<t:template>
							<Text text="{ConsequentListJsonModel>fromDate}"/>
						</t:template>
					</t:Column>
					<t:Column width="180px">
						<Label />
						<t:template>
							<HBox wrap="Wrap">
								<Button type="Transparent" press="onSee" icon="sap-icon://show"/>
								<Button type="Transparent" press="saveChanges" enabled="false" icon="sap-icon://save"/>
								<Button type="Transparent" press="onEditNove" icon="sap-icon://edit"/>
								<Button type="Transparent" press='onDelete' icon="sap-icon://delete"/>
							</HBox>
						</t:template>
					</t:Column>
				</t:Table>
			</FlexBox>
		</content>

		<footer>
			<OverflowToolbar>
				<ToolbarSpacer/>
				<Button type="Emphasized" text="{ parts: [ 'editModel>/editableMode' ], formatter: '.formatter.formatName' }" press="onSaveNovedad"/>
				<Button text="Cancelar" press="onNavBack"/>
			</OverflowToolbar>
		</footer>

	</Page>
</mvc:View>
