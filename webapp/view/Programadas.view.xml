<mvc:View xmlns:vbm="sap.ui.vbm" controllerName="transener.registrocronologicoeventos.controller.Programadas"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout">

    <Page id="ProgramadasPage" title="Tareas Programadas" titleAlignment="Center" enableScrolling="true" showNavButton="true" navButtonPress="onNavBack">

        <content>
            <FlexBox direction="Column" class="wrapper">
                <HBox class="container">
                    <VBox>
                        <Label text="{i18n>Ubicacion}" showColon="true" class="title"/>
                        <ComboBox id="cmbLugar" selectionChange=".onUbicacionChange" selectedKey="{NovedadesFormJsonModel>/Tplnr}" valueState="{NovedadesFormJsonModel>/TplnrState}" valueStateText="{NovedadesFormJsonModel>/TplnrStateMessage}" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}" class="cmbMD">
                            <core:ListItem key="{Estaciones>Codigo}" text="{Estaciones>Codigo} - {Estaciones>Descripcion}" />
                        </ComboBox>
                    </VBox>
                    <VBox>
                        <Label text="{i18n>CammesaEq}" showColon="true" class="title"/>
                        <ComboBox id="cmbEquipo" selectedKey="{NovedadesFormJsonModel>/Equnr}" valueState="{NovedadesFormJsonModel>/EqunrState}" class="cmbMD" valueStateText="{NovedadesFormJsonModel>/EqunrStateMessage}" items="{ path: 'EquiposModel>/Equipos', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}">
                            <core:ListItem key="{EquiposModel>CodigoEquipo}" text="{EquiposModel>CodigoEquipo} - {EquiposModel>DescEquipo}" />
                        </ComboBox>
                    </VBox>
                    <VBox>
                        <Label text="{i18n>statusEqCammesa}" showColon="true" class="title"/>
                        <ComboBox id="cmbStatusEquipo" selectedKey="{NovedadesFormJsonModel>/Equnr}" valueState="{NovedadesFormJsonModel>/EqunrState}" valueStateText="{NovedadesFormJsonModel>/EqunrStateMessage}" items="{ path: 'StatusModel>/Status', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}">
                            <core:ListItem key="{StatusModel>Codigo}" text="{StatusModel>Descripcion}" />
                        </ComboBox>
                    </VBox>
                    <VBox>
                        <Label text="{i18n>ltAsociadas}" showColon="true" class="title"/>
                        <ComboBox id="cmbLLTT" selectionChange=".onSelectionChange" selectedKey="{LicencesListJsonModel>/Licences}" items="{ path: 'LicencesListJsonModel>/Licences', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}">
                            <core:Item key="{Licences>IdLicencia}" text="{Licences>IdLicencia}"/>
                        </ComboBox>
                    </VBox>

                </HBox>
                <HBox class="container">
                    <VBox class="halfConte border_ctn">
                        <HBox justifyContent="SpaceBetween">
                            <Label text="Equipo Cammesa F/S" class="sapUiSmallMarginBottom" showColon="true"/>
                            <Button text="Consecuentes" class="sapUiLargeMarginEnd btn"/>
                        </HBox>
                        <VBox >
                            <Label text="Se descargo" />
                            <HBox justifyContent="SpaceBetween">
                                <ComboBox selectedKey="{NovedadesFormJsonModel>/Descargo}" valueState="{NovedadesFormJsonModel>/DescargoState}" class="cmbMD" valueStateText="{NovedadesFormJsonModel>/DescsrgoStateMessage}" items="{ path: 'EquiposModel>/Equipos', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}">
                                    <core:ListItem key="{EquiposModel>CodigoEquipo}" text="{EquiposModel>CodigoEquipo} - {EquiposModel>DescEquipo}" />
                                </ComboBox>
                                <DateTimePicker value="{ 'path': 'NovedadesFormJsonModel>/DescargoFecha', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }" editable="{= !${utilsModel>/readOnlyMode}}"/>
                            </HBox>
                        </VBox>
                        <VBox >
                            <Label text="Se desenergizo" />
                            <HBox justifyContent="SpaceBetween">
                                <ComboBox selectedKey="{NovedadesFormJsonModel>/Desenergizo}" valueState="{NovedadesFormJsonModel>/DesenergizoState}" class="cmbMD" valueStateText="{NovedadesFormJsonModel>/DesenergizoStateMessage}" items="{ path: 'EquiposModel>/Equipos', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}">
                                    <core:ListItem key="{EquiposModel>CodigoEquipo}" text="{EquiposModel>CodigoEquipo} - {EquiposModel>DescEquipo}" />
                                </ComboBox>
                                <DateTimePicker value="{ 'path': 'NovedadesFormJsonModel>/DesenergizoFecha', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }" editable="{= !${utilsModel>/readOnlyMode}}"/>
                            </HBox>
                        </VBox>
                    </VBox>
                    <VBox class="halfConte border_ctn">
                        <Label text="Equipo E/S a traves de" class="sapUiSmallMarginBottom" showColon="true"/>
                        <HBox justifyContent="SpaceBetween" height="51px">
                            <CheckBox text="Barra de transferencia" enabled="{= !${utilsModel>/readOnlyMode}}" class="checkBox"/>
                            <CheckBox text="Seleccionador de paso" enabled="{= !${utilsModel>/readOnlyMode}}" class="checkBox"/>
                            <CheckBox text="Acoplador" enabled="{= !${utilsModel>/readOnlyMode}}" class="checkBox"/>
                        </HBox>
                        <VBox >
                            <Label text="Equipo a intervenir" />
                            <HBox justifyContent="SpaceBetween">
                                <ComboBox selectedKey="{NovedadesFormJsonModel>/EquipoIntervenir}" valueState="{NovedadesFormJsonModel>/EquipoIntervenirState}" class="cmbMD" valueStateText="{NovedadesFormJsonModel>/EquipoIntervenirStateMessage}" items="{ path: 'EquiposModel>/Equipos', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}">
                                    <core:ListItem key="{EquiposModel>CodigoEquipo}" text="{EquiposModel>CodigoEquipo} - {EquiposModel>DescEquipo}" />
                                </ComboBox>
                                <DateTimePicker value="{ 'path': 'NovedadesFormJsonModel>/EquipoIntervenirFecha', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }" editable="{= !${utilsModel>/readOnlyMode}}"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </HBox>
                <HBox class="container">
                    <VBox class="halfConte">
                        <Label text="Falla de equipos durante la maniobra" showColon="true"/>
                        <ComboBox selectedKey="{NovedadesFormJsonModel>/FallaEquipoManiobra}" items="{EmpresaTramitacionJsonModel>/Empresas}" showSecondaryValues="true" enabled="{= !${utilsModel>/readOnlyMode}}" class="cmbLG">
                            <core:ListItem key="{EmpresaTramitacionJsonModel>Codigo}" text="{EmpresaTramitacionJsonModel>Descripcion}" additionalText="{EmpresaTramitacionJsonModel>Codigo}" />
                        </ComboBox>
                        <Label text="Se informó a Empresa"/>
                        <ComboBox selectedKey="{NovedadesFormJsonModel>/Informoemp}" items="{EmpresaTramitacionJsonModel>/Empresas}" showSecondaryValues="true" enabled="{= !${utilsModel>/readOnlyMode}}" class="cmbLG">
                            <core:ListItem key="{EmpresaTramitacionJsonModel>Codigo}" text="{EmpresaTramitacionJsonModel>Descripcion}" additionalText="{EmpresaTramitacionJsonModel>Codigo}" />
                        </ComboBox>
                    </VBox>
                    <VBox class="halfConte">
                        <Label text="Comentarios"/>
                        <TextArea value="{NovedadesFormJsonModel>/Comentarios}" width="100%"/>
                    </VBox>
                </HBox>
                <IconTabBar  class="IconTitle">
                    <items>
                        <IconTabFilter text="Normalizacion de la Instalacion" >
                            <HBox class="container">
                                <VBox class="halfConte border_ctn">

                                    <Label text="Equipo Cammesa E/S" class="sapUiSmallMarginBottom" showColon="true"/>

                                    <VBox >
                                        <Label text="Se energizó desde" showColon="true" />
                                        <HBox justifyContent="SpaceBetween">
                                            <ComboBox selectedKey="{NormalizacionNS>/Energizo}" valueState="{NormalizacionNS>/EnergizoState}" class="cmbMD" valueStateText="{NormalizacionNS>/EnergizoStateMessage}" items="{ path: 'EquiposModel>/Equipos', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}">
                                                <core:ListItem key="{EquiposModel>CodigoEquipo}" text="{EquiposModel>CodigoEquipo} - {EquiposModel>DescEquipo}" />
                                            </ComboBox>
                                            <DateTimePicker value="{ 'path': 'NovedadesFormJsonModel>/EnergizoFecha', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }" editable="{= !${utilsModel>/readOnlyMode}}"/>
                                        </HBox>
                                    </VBox>
                                    <VBox >
                                        <Label text="En Servicio" showColon="true" />
                                        <HBox justifyContent="SpaceBetween">
                                            <ComboBox selectedKey="{NormalizacionNS>/EnServicio}" valueState="{NormalizacionNS>/EnServicioState}" class="cmbMD" valueStateText="{NormalizacionNS>/EnServicioStateMessage}" items="{ path: 'EquiposModel>/Equipos', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}">
                                                <core:ListItem key="{EquiposModel>CodigoEquipo}" text="{EquiposModel>CodigoEquipo} - {EquiposModel>DescEquipo}" />
                                            </ComboBox>
                                            <DateTimePicker value="{ 'path': 'NovedadesFormJsonModel>/EnServicioFecha', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }" editable="{= !${utilsModel>/readOnlyMode}}"/>
                                        </HBox>
                                    </VBox>
                                </VBox>
                                <VBox class="halfConte border_ctn">
                                    <HBox alignItems="Center" justifyContent="SpaceBetween">
                                        <Label text="E/S a través de interruptor propio" />
                                        <DateTimePicker value="{ 'path': 'NormalizacionNS>/ESIntPropioFecha', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }" editable="{= !${utilsModel>/readOnlyMode}}"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                            <HBox class="container">

                                <VBox class="halfConte">
                                    <Label text="Comentarios"/>
                                    <TextArea value="{NormalizacionNS>/Comentarios}" width="100%"/>
                                </VBox>
                                <VBox class="halfConte">
                                    <Label text="Falla de equipos durante la maniobra" showColon="true"/>
                                    <ComboBox selectedKey="{NormalizacionNS>/FallaEqManiobra}" items="{EmpresaTramitacionJsonModel>/Empresas}" showSecondaryValues="true" enabled="{= !${utilsModel>/readOnlyMode}}" class="cmbLG">
                                        <core:ListItem key="{EmpresaTramitacionJsonModel>Codigo}" text="{EmpresaTramitacionJsonModel>Descripcion}" additionalText="{EmpresaTramitacionJsonModel>Codigo}" />
                                    </ComboBox>
                                </VBox>

                            </HBox>
                            <VBox class="container border_ctn">
                                <Label text="Avisos"/>
                                <HBox >
                                    <VBox class="halfConte">
                                        <Label text="Se informó a Empresa"/>
                                        <ComboBox selectedKey="{NormalizacionNS>/InformoEmp}" items="{EmpresaTramitacionJsonModel>/Empresas}" showSecondaryValues="true" enabled="{= !${utilsModel>/readOnlyMode}}" class="cmbLG">
                                            <core:ListItem key="{EmpresaTramitacionJsonModel>Codigo}" text="{EmpresaTramitacionJsonModel>Descripcion}" additionalText="{EmpresaTramitacionJsonModel>Codigo}" />
                                        </ComboBox>
                                    </VBox>
                                    <VBox class="halfConte">
                                        <Label text="Comentarios" showColon="true"/>
                                        <TextArea value="{NormalizacionNS>/ComentariosAviso}" width="100%"/>
                                    </VBox>

                                </HBox>
                            </VBox>
                        </IconTabFilter>
                    </items>
                </IconTabBar>

                <IconTabBar class="IconTitle" >
                    <items>
                        <IconTabFilter text="Indisponibilidades">
                            <VBox class="container border_ctn">
                                <HBox class="container">
                                    <VBox width="100%">
                                        <HBox class="HBoxContent">
                                            <Label text="Causa" showColon="true" />
                                            <ComboBox busy="{CausasJsonModel>Busy}" selectedKey="{NovedadesFormJsonModel>/CodCausa}" valueState="{NovedadesFormJsonModel>/CodCausaState}" valueStateText="{NovedadesFormJsonModel>/CodCausaStateMessage}" items="{CausasJsonModel>/Causas}" enabled="{= !${utilsModel>/readOnlyMode}}">
                                                <core:Item key="{CausasJsonModel>CodigoCausa}" text="{CausasJsonModel>DescCausa}"/>
                                            </ComboBox>
                                        </HBox>
                                        <HBox class="HBoxContent">
                                            <Label text="Motivo" showColon="true" />
                                            <ComboBox selectionChange=".onMotivoChange" busy="{MotivosJsonModel>Busy}" selectedKey="{NovedadesFormJsonModel>/CodMotivo}" valueState="{NovedadesFormJsonModel>/CodMotivoState}" valueStateText="{NovedadesFormJsonModel>/CodMotivoStateMessage}" items="{ path: 'MotivosJsonModel>/', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}">
                                                <core:Item key="{MotivosJsonModel>CodigoMotivo}" text="{MotivosJsonModel>DescMotivo}"/>
                                            </ComboBox>
                                        </HBox>
                                    </VBox>
                                    <VBox width="100%">
                                        <HBox class="HBoxContent">
                                            <Label text="Indisponible" showColon="true" />
                                            <DateTimePicker value="{ 'path': 'NovedadesFormJsonModel>/InicioNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }" editable="{= !${utilsModel>/readOnlyMode}}"/>
                                        </HBox>
                                        <HBox class="HBoxContent">
                                            <Label text="Disponible" showColon="true" />
                                            <DateTimePicker value="{ 'path': 'NovedadesFormJsonModel>/FinNov', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }" editable="{= !${utilsModel>/readOnlyMode}}"/>
                                        </HBox>
                                    </VBox>
                                    <VBox width="100%">
                                        <HBox class="HBoxContent">
                                            <Label text="Referencia" class="sapUiTinyMarginEnd"/>
                                            <Input enabled="false" value="{NovedadesFormJsonModel>/IdNovedad}" width="150px"/>
                                        </HBox>
                                        <HBox class="HBoxContent">
                                            <Label text="SubIndice" class="sapUiTinyMarginEnd"/>
                                            <Input enabled="false" value="{NovedadesFormJsonModel>/Subindice}" width="150px"/>
                                        </HBox>
                                    </VBox>

                                </HBox>
                                <HBox >
                                    <VBox class="halfConte">
                                        <Label text="Comentarios (Parte de Indisponibilidad)"/>
                                        <TextArea value="{InformaCammesa>/Texto}" width="100%"/>
                                        <HBox alignItems="Center">
                                            <Label text="La indisponibilidad se informa a CAMMESA :" />
                                            <CheckBox selected="{InformaCammesa>/InformaCammesa}" />
                                        </HBox>
                                    </VBox>
                                    <VBox class="halfConte">
                                        <Label text="Comentarios" showColon="true"/>
                                        <TextArea value="{InformaCammesa>/Texto}" width="100%"/>
                                    </VBox>

                                </HBox>
                            </VBox>
                        </IconTabFilter>
                    </items>
                </IconTabBar>

            </FlexBox>
        </content>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <!-- equivalente a beginButton -->
                <Button type="Emphasized" text="{ parts: [ 'editModel>/editableMode' ], formatter: '.formatter.formatName' }" press="onSaveNovedad"/>
                <!-- equivalente a endButton -->
                <Button text="Cerrar" press="onNavBack"/>
            </OverflowToolbar>
        </footer>

    </Page>
</mvc:View>
