<mvc:View controllerName="transener.registrocronologicoeventos.controller.Novedades"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page id="NovedadesPage" title="Novedades del sistema LG" titleAlignment="Center" enableScrolling="true" showNavButton="true" navButtonPress="onNavBack">
        <content>
            <FlexBox class="wrapper" direction="Column">

                <!-- Seccion: Datos de Novedad -->
                <VBox class="border_ctn sapUiSmallMarginBottom">
                    <HBox class="sectionHeader" alignItems="Center">
                        <core:Icon src="sap-icon://document-text" class="sapUiSmallMarginEnd" color="#004da4"/>
                        <Title text="Datos de Novedad" level="H5"/>
                    </HBox>
                    <HBox class="container" justifyContent="SpaceBetween">
                        <VBox>
                            <Label text="Tipo de Novedad" showColon="true" class="sectionLabel"/>
                            <ComboBox width="300px" selectionChange=".onNovedadSelected" selectedKey="{NovedadLGFormJsonModel>/CodNovedad}" valueState="{NovedadLGFormJsonModel>/CodNovedadState}" valueStateText="{NovedadLGFormJsonModel>/CodNovedadStateMessage}" items="{ path: 'Novedades>/novs', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode} &amp;&amp; ${editModel>/mode} !== 'edit'}">
                                <core:ListItem key="{Novedades>Codigo}" text="{Novedades>Codigo} - {Novedades>Descripcion}" enabled="{parts:[{path:'Novedades>Codigo'},{path:'editModel>/mode'}], formatter:'.formatter.isNovedadEnabled'}"/>
                            </ComboBox>
                        </VBox>
                        <VBox>
                            <Label text="Ubicacion" showColon="true" class="sectionLabel"/>
                            <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadLGFormJsonModel>/Tplnr}" valueState="{NovedadLGFormJsonModel>/TplnrState}" valueStateText="{NovedadLGFormJsonModel>/TplnrStateMessage}" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}">
                                <core:Item key="{Estaciones>Codigo}" text="{Estaciones>Codigo} - {Estaciones>Descripcion}"/>
                            </ComboBox>
                        </VBox>
                        <VBox>
                            <Label text="Equipo" showColon="true" class="sectionLabel"/>
                            <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadLGFormJsonModel>/Equnr}" valueState="{NovedadLGFormJsonModel>/EqunrState}" valueStateText="{NovedadLGFormJsonModel>/EqunrStateMessage}" items="{ path: 'EquiposModel>/Equipos', templateShareable: true }" enabled="{= !${utilsModel>/readOnlyMode}}">
                                <core:ListItem key="{EquiposModel>CodigoEquipo}" text="{EquiposModel>CodigoEquipo} - {EquiposModel>DescEquipo}"/>
                            </ComboBox>
                        </VBox>
                        <VBox>
                            <Label text="Referencia" showColon="true" class="sectionLabel"/>
                            <Input value="{NovedadLGFormJsonModel>/Id}" enabled="false" width="250px"/>
                        </VBox>
                        <VBox>
                            <Label text="Fecha/Hora" showColon="true" class="sectionLabel"/>
                            <DateTimePicker value="{ 'path': 'NovedadLGFormJsonModel>/InicioNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }" valueState="{NovedadLGFormJsonModel>/InicioNoveState}" valueStateText="{NovedadLGFormJsonModel>/InicioNoveStateMessage}" enabled="{= !${utilsModel>/readOnlyMode}}"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox id="fragContainer" width="100%" class="sapUiSmallMarginTop"/>
            </FlexBox>
        
        </content>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button type="Emphasized" text="{ parts: [ 'editModel>/editableMode' ], formatter: '.formatter.formatName' }" press="onSaveGuardia" visible="{= !${utilsModel>/readOnlyMode}}"/>
                <Button text="Cancelar" press="onNavBack"/>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
