<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
<Dialog id="EnBandaFueraDeBanda" title="Perturbaciones / Desconexiones" titleAlignment="Start">
        <content>
    <FlexBox class="sapUiSmallMargin containerDialog" direction="Column">
        <HBox width="100%" class="sapUiSmallMarginBottom">
            <HBox width="100%" class="sapUiSmallMarginBotton FlexForm ">
                <VBox width="100%">
                    <HBox justifyContent="Start" alignItems="Center">
                        <Label text="Fuera de banda en el nivel de" showColon="true" class="sapUiSmallMarginEnd labels" />
                        <CheckBox text="500 kV" />
                        <CheckBox text="345/330 kV" />
                        <CheckBox text="220 kV" />
                        <CheckBox text="132 kV" />
                    </HBox>
                    <HBox justifyContent="Start" alignItems="Center">
                        <Label text="Tensión Requerida (KV)" class="sapUiSmallMarginEnd labels" />
                        <Input width="90px" />
                    </HBox>
                    <HBox width="100%">
                        <VBox alignItems="Start">
                            <Label text="Motivos" showColon="true" class="sapUiSmallMarginEnd labels" />
                            <HBox>
                                <TextArea width="600px" />
                            </HBox>
                        </VBox>
                    </HBox>
                    <HBox width="100%" justifyContent="Start">
                        <VBox alignItems="Start" class="sapUiLargeMarginEnd">
                            <Label text="Solicitado por" showColon="true" class="sapUiSmallMarginEnd labels" />
                            <HBox>
                             
                            <ComboBox width="300px"  selectedKey="{NovedadesFormJsonModel>/SolicitadoPor}" items="{ path: 'PersonalHabilitadoModel>/Todos', templateShareable: true }">
											<core:Item key="{PersonalHabilitadoModel>Codigo}" text="{PersonalHabilitadoModel>Legajo} - {PersonalHabilitadoModel>Nombre}"/>
										</ComboBox>
                            </HBox>
                        </VBox>
                        <VBox alignItems="Start">
                            <Label text="Se Informo a Empresa" class="sapUiSmallMarginEnd labels" showColon="true" />
                            <HBox>
                                <ComboBox  width="300px" selectionChange=".onSelectionChange"
													selectedKey="{NovedadesFormJsonModel>/InformoEmpresa}" items="{ path: 'EmpresaTramitacionJsonModel>/Empresas', templateShareable: true }">
													<core:Item key="{EmpresaTramitacionJsonModel>Codigo}"
														text="{EmpresaTramitacionJsonModel>Codigo} - {EmpresaTramitacionJsonModel>Descripcion}"/>
												</ComboBox>
                            </HBox>
                        </VBox>
                    </HBox>
                    <HBox width="100%">
                        <VBox alignItems="Start">
                            <Label text="Comentarios" showColon="true" class="sapUiSmallMarginEnd labels" />
                            <HBox>
                                <TextArea width="600px" />
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>
        </HBox>
        <VBox>
            <VBox width="100%" alignItems="Center" class="separador">
                <Title text="Normalización" />
            </VBox>
            <VBox width="100%" class="FlexForm">
                <HBox justifyContent="Start" alignItems="Center">
                    <Label text="Fecha/Hora en banda" class="sapUiSmallMarginEnd labels" showColon="true"/>
                    <HBox>
                        <DateTimePicker value="{ 'path': 'NovedadesFormJsonModel>/InicioNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }" />
                    </HBox>
                </HBox>
                <HBox width="100%" justifyContent="Start">
                    <VBox alignItems="Start" class="sapUiLargeMarginEnd">
                        <Label text="A solicitud de" showColon="true" class="sapUiSmallMarginEnd labels" />
                        <HBox>
                
                            <ComboBox width="300px"  selectedKey="{NovedadesFormJsonModel>/NormalizacionASolicitud}" items="{ path: 'PersonalHabilitadoModel>/Todos', templateShareable: true }">
											<core:Item key="{PersonalHabilitadoModel>Codigo}" text="{PersonalHabilitadoModel>Legajo} - {PersonalHabilitadoModel>Nombre}"/>
										</ComboBox>
                        </HBox>
                    </VBox>
                    <VBox alignItems="Start">
                        <Label text="Se Informo a Empresa" class="sapUiSmallMarginEnd labels" showColon="true" />
                        <HBox>
                
                           <ComboBox  width="300px" selectionChange=".onSelectionChange"
													selectedKey="{NovedadesFormJsonModel>/NormalizacionInformoEmpresa}" items="{ path: 'EmpresaTramitacionJsonModel>/Empresas', templateShareable: true }">
													<core:Item key="{EmpresaTramitacionJsonModel>Codigo}"
														text="{EmpresaTramitacionJsonModel>Codigo} - {EmpresaTramitacionJsonModel>Descripcion}"/>
												</ComboBox>
                        </HBox>
                    </VBox>
                </HBox>
                <HBox width="100%">
                    <VBox alignItems="Start">
                        <Label text="Comentarios" showColon="true" class="sapUiSmallMarginEnd labels" />
                        <HBox>
                            <TextArea width="600px" />
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </FlexBox>
       </content>
       <beginButton>
			<Button text="Guardar" press="onSaveNovedad"/>
		</beginButton>
		<endButton>
			<Button text="Cerrar" press="closeDialog"/>
		</endButton>
    </Dialog>
</core:FragmentDefinition>
