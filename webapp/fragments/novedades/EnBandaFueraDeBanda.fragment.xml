<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

    <FlexBox direction="Column" class="sapUiSmallMargin">

        <!-- Seccion: Fuera de Banda -->
        <VBox class="border_ctn sapUiSmallMarginBottom">
            <HBox class="sectionHeader" alignItems="Center">
                <core:Icon src="sap-icon://trend-up" class="sapUiSmallMarginEnd" color="#004da4"/>
                <Title text="Fuera de Banda" level="H5"/>
            </HBox>
            <VBox class="container">
                <HBox alignItems="Center">
                    <Label text="Fuera de banda en el nivel de" showColon="true" class="sectionLabel sapUiSmallMarginEnd"/>
                    <CheckBox text="500 kV"/>
                    <CheckBox text="345/330 kV"/>
                    <CheckBox text="220 kV"/>
                    <CheckBox text="132 kV"/>
                </HBox>
                <HBox alignItems="Center">
                    <Label text="Tension Requerida (KV)" class="sectionLabel sapUiSmallMarginEnd"/>
                    <Input width="90px"/>
                </HBox>
                <VBox>
                    <Label text="Motivos" showColon="true" class="sectionLabel"/>
                    <TextArea width="100%"/>
                </VBox>
                <HBox justifyContent="Start">
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Solicitado por" showColon="true" class="sectionLabel"/>
                        <ComboBox width="300px" selectedKey="{NovedadesFormJsonModel>/SolicitadoPor}" items="{ path: 'PersonalHabilitadoModel>/Todos', templateShareable: true }">
                            <core:Item key="{PersonalHabilitadoModel>Codigo}" text="{PersonalHabilitadoModel>Legajo} - {PersonalHabilitadoModel>Nombre}"/>
                        </ComboBox>
                    </VBox>
                    <VBox>
                        <Label text="Se Informo a Empresa" showColon="true" class="sectionLabel"/>
                        <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/InformoEmpresa}" items="{ path: 'EmpresaTramitacionJsonModel>/Empresas', templateShareable: true }">
                            <core:Item key="{EmpresaTramitacionJsonModel>Codigo}" text="{EmpresaTramitacionJsonModel>Codigo} - {EmpresaTramitacionJsonModel>Descripcion}"/>
                        </ComboBox>
                    </VBox>
                </HBox>
                <VBox>
                    <Label text="Comentarios" showColon="true" class="sectionLabel"/>
                    <TextArea width="100%"/>
                </VBox>
            </VBox>
        </VBox>

        <!-- Seccion: Normalizacion -->
        <VBox class="border_ctn sapUiSmallMarginBottom">
            <HBox class="sectionHeader" alignItems="Center">
                <core:Icon src="sap-icon://restart" class="sapUiSmallMarginEnd" color="#004da4"/>
                <Title text="Normalizacion" level="H5"/>
            </HBox>
            <VBox class="container">
                <HBox alignItems="End">
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Fecha/Hora en banda" showColon="true" class="sectionLabel"/>
                        <DateTimePicker value="{ 'path': 'NovedadesFormJsonModel>/InicioNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
                    </VBox>
                </HBox>
                <HBox justifyContent="Start">
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="A solicitud de" showColon="true" class="sectionLabel"/>
                        <ComboBox width="300px" selectedKey="{NovedadesFormJsonModel>/NormalizacionASolicitud}" items="{ path: 'PersonalHabilitadoModel>/Todos', templateShareable: true }">
                            <core:Item key="{PersonalHabilitadoModel>Codigo}" text="{PersonalHabilitadoModel>Legajo} - {PersonalHabilitadoModel>Nombre}"/>
                        </ComboBox>
                    </VBox>
                    <VBox>
                        <Label text="Se Informo a Empresa" showColon="true" class="sectionLabel"/>
                        <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/NormalizacionInformoEmpresa}" items="{ path: 'EmpresaTramitacionJsonModel>/Empresas', templateShareable: true }">
                            <core:Item key="{EmpresaTramitacionJsonModel>Codigo}" text="{EmpresaTramitacionJsonModel>Codigo} - {EmpresaTramitacionJsonModel>Descripcion}"/>
                        </ComboBox>
                    </VBox>
                </HBox>
                <VBox>
                    <Label text="Comentarios" showColon="true" class="sectionLabel"/>
                    <TextArea width="100%"/>
                </VBox>
            </VBox>
        </VBox>

    </FlexBox>

</core:FragmentDefinition>
