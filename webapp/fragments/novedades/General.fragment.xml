<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <FlexBox direction="Column" class="sapUiSmallMargin">
        <VBox class="border_ctn sapUiSmallMarginBottom">
            <HBox class="sectionHeader" alignItems="Center">
                <core:Icon src="sap-icon://comment" class="sapUiSmallMarginEnd" color="#004da4"/>
                <Title text="General" level="H5"/>
            </HBox>
            <VBox class="container">
                <Label text="Comentarios" showColon="true" class="sectionLabel"/>
                <TextArea width="100%" value="{NovedadLGFormJsonModel>/Novedad}" editable="{= !${utilsModel>/readOnlyMode}}"/>
            </VBox>
        </VBox>
    </FlexBox>

</core:FragmentDefinition>
