<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

    <FlexBox direction="Column" class="sapUiSmallMargin">

        <!-- Seccion: Transferencia de Carga -->
        <VBox class="border_ctn sapUiSmallMarginBottom">
            <HBox class="sectionHeader" alignItems="Center">
                <core:Icon src="sap-icon://transfer" class="sapUiSmallMarginEnd" color="#004da4"/>
                <Title text="Transferencia de Carga" level="H5"/>
            </HBox>
            <VBox class="container">
                <HBox alignItems="Center">
                    <Label text="Se transfiere carga Desde" showColon="true" class="sectionLabel sapUiSmallMarginEnd"/>
                    <ComboBox selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Tplnr}" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }" class="sapUiSmallMarginEnd">
                        <core:Item key="{Estaciones>Estacion}" text="{path: 'Estaciones>Descripcion'}"/>
                    </ComboBox>
                    <ComboBox selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Tplnr}" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }" class="sapUiSmallMarginEnd">
                        <core:Item key="{Estaciones>Estacion}" text="{path: 'Estaciones>Descripcion'}"/>
                    </ComboBox>
                    <Label text="Potencia transferida" showColon="true" class="sectionLabel sapUiSmallMarginEnd"/>
                    <Input/>
                    <Label text="MW" class="sapUiSmallMarginBegin"/>
                </HBox>
                <VBox>
                    <Label text="Motivo" showColon="true" class="sectionLabel"/>
                    <TextArea width="100%"/>
                </VBox>
                <VBox>
                    <Label text="Se Informo a Personal" showColon="true" class="sectionLabel"/>
                    <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Tplnr}" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }">
                        <core:Item key="{Estaciones>Estacion}" text="{path: 'Estaciones>Descripcion'}"/>
                    </ComboBox>
                </VBox>
                <VBox>
                    <Label text="Comentarios" showColon="true" class="sectionLabel"/>
                    <TextArea width="100%"/>
                </VBox>
            </VBox>
        </VBox>

        <!-- Seccion: Normalizacion de la Instalacion -->
        <VBox class="border_ctn sapUiSmallMarginBottom">
            <HBox class="sectionHeader" alignItems="Center">
                <core:Icon src="sap-icon://restart" class="sapUiSmallMarginEnd" color="#004da4"/>
                <Title text="Normalizacion de la Instalacion" level="H5"/>
            </HBox>
            <VBox class="container">
                <HBox justifyContent="Start" alignItems="End">
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Fecha/Hora" showColon="true" class="sectionLabel"/>
                        <DatePicker/>
                    </VBox>
                    <VBox>
                        <Label text="Se Informo a Empresa" showColon="true" class="sectionLabel"/>
                        <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/CodTipo}" items="{ path: 'TipoModel>/Tipo', templateShareable: true }">
                            <core:ListItem key="{TipoModel>Tipo}" text="{TipoModel>Descripcion}"/>
                        </ComboBox>
                    </VBox>
                </HBox>
                <VBox>
                    <Label text="Comentarios" showColon="true" class="sectionLabel"/>
                    <TextArea width="100%"/>
                </VBox>
            </VBox>
        </VBox>

    </FlexBox>

</core:FragmentDefinition>
