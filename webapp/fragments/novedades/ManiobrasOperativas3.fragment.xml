<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

    <FlexBox direction="Column" class="sapUiSmallMargin">

        <!-- Seccion: Paralelo -->
        <VBox class="border_ctn sapUiSmallMarginBottom">
            <HBox class="sectionHeader" alignItems="Center">
                <core:Icon src="sap-icon://parallel-processes" class="sapUiSmallMarginEnd" color="#004da4"/>
                <Title text="Paralelo" level="H5"/>
            </HBox>
            <VBox class="container">
                <HBox justifyContent="SpaceBetween">
                    <HBox alignItems="Center">
                        <Label text="En paralelo en el nivel de" showColon="true" class="sectionLabel sapUiSmallMarginEnd"/>
                        <CheckBox text="33 kV"/>
                        <CheckBox text="13.2 kV"/>
                    </HBox>
                    <HBox alignItems="Center">
                        <Label text="Motivo" showColon="true" class="sectionLabel sapUiSmallMarginEnd"/>
                        <CheckBox text="Carga"/>
                        <CheckBox text="Operativo"/>
                    </HBox>
                </HBox>
                <VBox>
                    <Label text="Se Informo a Empresa" showColon="true" class="sectionLabel"/>
                    <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Tplnr}" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }">
                        <core:Item key="{Estaciones>Estacion}" text="{path: 'Estaciones>Descripcion'}"/>
                    </ComboBox>
                </VBox>
                <VBox>
                    <Label text="Comentarios" showColon="true" class="sectionLabel"/>
                    <TextArea width="100%"/>
                </VBox>
            </VBox>
        </VBox>

        <!-- Seccion: Normalizacion -->
        <VBox class="border_ctn sapUiSmallMarginBottom">
            <HBox class="sectionHeader" alignItems="Center">
                <core:Icon src="sap-icon://restart" class="sapUiSmallMarginEnd" color="#004da4"/>
                <Title text="Normalizacion" level="H5"/>
            </HBox>
            <VBox class="container">
                <HBox justifyContent="SpaceBetween">
                    <HBox alignItems="Center">
                        <Label text="Fuera de paralelo en el nivel de" showColon="true" class="sectionLabel sapUiSmallMarginEnd"/>
                        <CheckBox text="33 kV"/>
                        <CheckBox text="13.2 kV"/>
                    </HBox>
                    <VBox>
                        <Label text="Fecha/Hora" showColon="true" class="sectionLabel"/>
                        <DatePicker/>
                    </VBox>
                </HBox>
                <HBox alignItems="Center">
                    <Label text="Configuracion habitual" showColon="true" class="sectionLabel sapUiSmallMarginEnd"/>
                    <CheckBox/>
                </HBox>
                <VBox>
                    <Label text="Se Informo a Empresa" showColon="true" class="sectionLabel"/>
                    <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Tplnr}" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }">
                        <core:Item key="{Estaciones>Estacion}" text="{path: 'Estaciones>Descripcion'}"/>
                    </ComboBox>
                </VBox>
                <VBox>
                    <Label text="Comentarios" showColon="true" class="sectionLabel"/>
                    <TextArea width="100%"/>
                </VBox>
            </VBox>
        </VBox>

    </FlexBox>

</core:FragmentDefinition>
