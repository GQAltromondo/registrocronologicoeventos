<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <FlexBox direction="Column" class="sapUiSmallMargin">

        <!-- Seccion: Carga de Equipos -->
        <VBox class="border_ctn sapUiSmallMarginBottom">
            <HBox class="sectionHeader" alignItems="Center">
                <core:Icon src="sap-icon://machine" class="sapUiSmallMarginEnd" color="#004da4"/>
                <Title text="Carga de Equipos" level="H5"/>
            </HBox>
            <VBox class="container">
                <HBox alignItems="Center">
                    <Label text="Porcentaje de carga / Superacion de limite / Supera valor nominal" showColon="true" class="sectionLabel sapUiSmallMarginEnd"/>
                    <Input value="{CargaFormJsonModel>/porcen}"/>
                </HBox>
                <HBox justifyContent="Start">
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Se informa a Empresa" showColon="true" class="sectionLabel"/>
                        <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{CargaFormJsonModel>/InformoEmpresa}" items="{ path: 'EmpresaTramitacionJsonModel>/Empresas', templateShareable: true }">
                            <core:Item key="{EmpresaTramitacionJsonModel>Codigo}" text="{EmpresaTramitacionJsonModel>Codigo} - {EmpresaTramitacionJsonModel>Descripcion}"/>
                        </ComboBox>
                    </VBox>
                    <VBox>
                        <Label text="Fecha/Hora" showColon="true" class="sectionLabel"/>
                        <DateTimePicker value="{ 'path': 'CargaFormJsonModel>/FechaHora', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
                    </VBox>
                </HBox>
                <VBox>
                    <Label text="Comentarios" showColon="true" class="sectionLabel"/>
                    <TextArea value="{CargaFormJsonModel>/Comentarios}" width="100%"/>
                </VBox>
            </VBox>
        </VBox>

        <!-- Seccion: Normalizacion -->
        <VBox class="border_ctn sapUiSmallMarginBottom">
            <HBox class="sectionHeader" alignItems="Center">
                <core:Icon src="sap-icon://restart" class="sapUiSmallMarginEnd" color="#004da4"/>
                <Title text="Normalizacion" level="H5"/>
            </HBox>
            <VBox class="container">
                <HBox justifyContent="Start">
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Fecha / Hora" showColon="true" class="sectionLabel"/>
                        <DateTimePicker value="{ 'path': 'NormalizacionCarga>/Fechahora', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
                    </VBox>
                    <VBox>
                        <Label text="Se Informo a Empresa" showColon="true" class="sectionLabel"/>
                        <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NormalizacionCarga>/NormalizacionInformoEmpresa}" items="{ path: 'EmpresaTramitacionJsonModel>/Empresas', templateShareable: true }">
                            <core:Item key="{EmpresaTramitacionJsonModel>Codigo}" text="{EmpresaTramitacionJsonModel>Codigo} - {EmpresaTramitacionJsonModel>Descripcion}"/>
                        </ComboBox>
                    </VBox>
                </HBox>
                <VBox>
                    <Label text="Medidas adoptadas" showColon="true" class="sectionLabel"/>
                    <HBox alignItems="Center">
                        <CheckBox text="Se Ingreso generacion"/>
                        <CheckBox text="Se Restringio generacion"/>
                    </HBox>
                    <HBox alignItems="Center">
                        <CheckBox text="Corte de demanda"/>
                        <CheckBox text="Sin intervencion"/>
                    </HBox>
                    <HBox alignItems="Center">
                        <CheckBox text="Se cambio la configuracion de red" class="sapUiMediumMarginEnd"/>
                        <Label text="Reduccion de tension" class="sapUiSmallMarginEnd"/>
                        <CheckBox text="10%"/>
                        <CheckBox text="5%"/>
                        <CheckBox text="Otro"/>
                    </HBox>
                </VBox>
                <HBox alignItems="End">
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Otra Medida" showColon="true" class="sectionLabel"/>
                        <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NormalizacionCarga>/otrasMedidas}" items="{ path: 'medidasModel>/Medidas', templateShareable: true }">
                            <core:ListItem key="{medidasModel>Codigo}" text="{medidasModel>Descripcion}"/>
                        </ComboBox>
                    </VBox>
                    <VBox>
                        <Label text="Fecha / Hora finalizacion medidas" showColon="true" class="sectionLabel"/>
                        <DateTimePicker value="{ 'path': 'NormalizacionCarga>/FechaFinMedidas', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
                    </VBox>
                </HBox>
                <VBox>
                    <Label text="Comentarios" showColon="true" class="sectionLabel"/>
                    <TextArea value="{NormalizacionCarga>/Comentarios}" width="100%"/>
                </VBox>
            </VBox>
        </VBox>

    </FlexBox>

</core:FragmentDefinition>
