<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <FlexBox class="sapUiSmallMargin containerDialog" direction="Column">
        <HBox width="100%" class="sapUiSmallMarginBottom">
            <HBox width="100%" class="sapUiSmallMarginBotton FlexForm">
                <VBox width="100%">
                    <HBox justifyContent="Start" alignItems="Center">
                        <Label text="Porcentaje de carga / Superacion de limite / Supera valor nominal" class="sapUiSmallMarginEnd labels" showColon="true" />
                        <Input value="{CargaFormJsonModel>/porcen}" class="sapUiSmallMarginEnd" />
                    </HBox>
                    <HBox width="100%" justifyContent="Start">
                        <HBox alignItems="Center" class="sapUiLargeMarginEnd">
                            <Label text="Se informa a Empresa" showColon="true" class="sapUiSmallMarginEnd labels" />
                            <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{CargaFormJsonModel>/InformoEmpresa}" items="{ path: 'EmpresaTramitacionJsonModel>/Empresas', templateShareable: true }">
                                <core:Item key="{EmpresaTramitacionJsonModel>Codigo}" text="{EmpresaTramitacionJsonModel>Codigo} - {EmpresaTramitacionJsonModel>Descripcion}"/>
                            </ComboBox>
                        </HBox>
                        <HBox alignItems="Center">
                            <Label text="Fecha/Hora" class="sapUiSmallMarginEnd labels" showColon="true" />

                            <DateTimePicker value="{ 'path': 'CargaFormJsonModel>/FechaHora', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }" />
                        </HBox>
                    </HBox>
                    <HBox width="100%">
                        <VBox alignItems="Start">
                            <Label text="Comentarios" showColon="true" class="sapUiSmallMarginEnd labels" />
                            <HBox>
                                <TextArea value="{CargaFormJsonModel>/Comentarios}" width="600px" />
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>
        </HBox>
        <VBox width="100%" alignItems="Center" class="separador">
            <Title text="Normalización" />
        </VBox>
        <VBox>
            <VBox width="100%" class="FlexForm">
                <HBox width="100%" justifyContent="Start">
                    <HBox alignItems="Center" class="sapUiLargeMarginEnd">
                        <Label text="Fecha / Hora" showColon="true" class="sapUiSmallMarginEnd labels" />
                        <HBox>
                            <DateTimePicker value="{ 'path': 'NormalizacionCarga>/Fechahora', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }" />
                        </HBox>
                    </HBox>
                    <HBox alignItems="Center">
                        <Label text="Se Informo a Empresa" class="sapUiSmallMarginEnd labels" showColon="true" />
                        <HBox>
                            <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NormalizacionCarga>/NormalizacionInformoEmpresa}" items="{ path: 'EmpresaTramitacionJsonModel>/Empresas', templateShareable: true }">
                                <core:Item key="{EmpresaTramitacionJsonModel>Codigo}" text="{EmpresaTramitacionJsonModel>Codigo} - {EmpresaTramitacionJsonModel>Descripcion}"/>
                            </ComboBox>
                        </HBox>
                    </HBox>
                </HBox>
                <VBox width="100%" justifyContent="Start">
                    <Label text="Medidas adoptadas para reducir la carga del transformador / Superacion de limite / Supera valor nominal" class="sapUiSmallMarginEnd labels" showColon="true" />

                    <HBox alignItems="Center" class="sapUiLargeMarginEnd">
                        <CheckBox text="Se Ingreso generación" />
                        <CheckBox text="Se Restringio generación" />
                    </HBox>
                    <HBox alignItems="Center" class="sapUiLargeMarginEnd">
                        <CheckBox text="Corte de demanda" />
                        <CheckBox text="Sin intervención" />
                    </HBox>
                    <HBox alignItems="Center" class="sapUiLargeMarginEnd">
                        <CheckBox text="Se cambio la configuracion de red" class="sapUiLargeMarginEnd" />
                        <HBox alignItems="Center">
                            <Label text="Reduccion de tensión" />
                            <CheckBox text="10%" />
                            <CheckBox text="5%" />
                            <CheckBox text="Otro" />
                        </HBox>
                    </HBox>
                    <HBox alignItems="Center">
                        <Label text="Otra Medida" class="sapUiSmallMarginEnd labels" showColon="true" />
                        <HBox>
                            <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NormalizacionCarga>/otrasMedidas}" items="{ path: 'medidasModel>/Medidas', templateShareable: true }">
                                <core:ListItem key="{medidasModel>Codigo}" text="{medidasModel>Descripcion}" />
                            </ComboBox>
                        </HBox>
                    </HBox>
                    <HBox alignItems="Center" class="sapUiLargeMarginEnd">
                        <Label text="Fecha / Hora de finalizacion de las medidas adoptadas" showColon="true" class="sapUiSmallMarginEnd labels" />
                        <HBox>
                            <DateTimePicker value="{ 'path': 'NormalizacionCarga>/FechaFinMedidas', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }" />
                        </HBox>
                    </HBox>
                </VBox>
                <HBox width="100%">
                    <VBox alignItems="Start">
                        <Label text="Comentarios " showColon="true" class="sapUiSmallMarginEnd labels" />
                        <HBox>
                            <TextArea value="{NormalizacionCarga>/Comentarios }" width="600px" />
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </FlexBox>

</core:FragmentDefinition>
