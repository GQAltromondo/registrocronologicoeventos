<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <FlexBox direction="Column" class="sapUiSmallMargin">

        <!-- Seccion: Vinculado Sin Tension -->
        <VBox class="border_ctn sapUiSmallMarginBottom">
            <HBox class="sectionHeader" alignItems="Center">
                <core:Icon src="sap-icon://disconnected" class="sapUiSmallMarginEnd" color="#004da4"/>
                <Title text="Vinculado Sin Tension" level="H5"/>
            </HBox>
            <VBox class="container">
                <HBox justifyContent="Start">
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Equipo CAMMESA" showColon="true" class="sectionLabel"/>
                        <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/CodCausa}" items="{ path: 'CausasJsonModel>/Causas', templateShareable: true }">
                            <core:ListItem key="{CausasJsonModel>CodigoCausa}" text="{CausasJsonModel>DescCausa}" additionalText="{CausasJsonModel>CodigoCausa}"/>
                        </ComboBox>
                    </VBox>
                    <VBox>
                        <Label text="LLTT asociadas" showColon="true" class="sectionLabel"/>
                        <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/CodCausa}" items="{ path: 'CausasJsonModel>/Causas', templateShareable: true }">
                            <core:ListItem key="{CausasJsonModel>CodigoCausa}" text="{CausasJsonModel>DescCausa}" additionalText="{CausasJsonModel>CodigoCausa}"/>
                        </ComboBox>
                    </VBox>
                </HBox>
                <HBox justifyContent="Start">
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Fuera de Servicio desde" showColon="true" class="sectionLabel"/>
                        <DateTimePicker value="{ 'path': 'NovedadesFormJsonModel>/InicioNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
                    </VBox>
                    <VBox>
                        <Label text="En Servicio (E/S)" showColon="true" class="sectionLabel"/>
                        <DateTimePicker value="{ 'path': 'NovedadesFormJsonModel>/InicioNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
                    </VBox>
                </HBox>
                <HBox justifyContent="Start">
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Indisponible desde" showColon="true" class="sectionLabel"/>
                        <DateTimePicker value="{ 'path': 'NovedadesFormJsonModel>/InicioNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
                    </VBox>
                    <VBox>
                        <Label text="Disponible desde" showColon="true" class="sectionLabel"/>
                        <DateTimePicker value="{ 'path': 'NovedadesFormJsonModel>/InicioNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>

        <!-- Seccion: Detalles -->
        <VBox class="border_ctn sapUiSmallMarginBottom">
            <HBox class="sectionHeader" alignItems="Center">
                <core:Icon src="sap-icon://detail-view" class="sapUiSmallMarginEnd" color="#004da4"/>
                <Title text="Detalles" level="H5"/>
            </HBox>
            <VBox class="container">
                <HBox justifyContent="Start">
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Causa" showColon="true" class="sectionLabel"/>
                        <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/CodCausa}" valueState="{NovedadesFormJsonModel>/CodCausaState}" valueStateText="{NovedadesFormJsonModel>/CodCausaStateMessage}" items="{ path: 'CausasJsonModel>/Causas', templateShareable: true }">
                            <core:ListItem key="{CausasJsonModel>CodigoCausa}" text="{CausasJsonModel>DescCausa}" additionalText="{CausasJsonModel>CodigoCausa}"/>
                        </ComboBox>
                    </VBox>
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Motivo" showColon="true" class="sectionLabel"/>
                        <ComboBox width="300px" selectionChange=".onSelectionChange" busy="{MotivosJsonModel>Busy}" selectedKey="{NovedadesFormJsonModel>/CodMotivo}" valueState="{NovedadesFormJsonModel>/CodMotivoState}" valueStateText="{NovedadesFormJsonModel>/CodMotivoStateMessage}" items="{ path: 'MotivosJsonModel>/', templateShareable: true }">
                            <core:ListItem key="{MotivosJsonModel>CodigoMotivo}" text="{MotivosJsonModel>DescMotivo}" additionalText="{MotivosJsonModel>CodigoMotivo}"/>
                        </ComboBox>
                    </VBox>
                    <HBox alignItems="Center">
                        <Label text="Vinculado y sin Tension" showColon="true" class="sectionLabel sapUiSmallMarginEnd"/>
                        <CheckBox/>
                    </HBox>
                </HBox>
                <VBox>
                    <Label text="Comentarios" showColon="true" class="sectionLabel"/>
                    <TextArea width="100%"/>
                </VBox>
                <HBox alignItems="Center" justifyContent="End">
                    <Label text="La indisponibilidad se informa a CAMMESA" showColon="true" class="sectionLabel sapUiSmallMarginEnd"/>
                    <CheckBox text="SI"/>
                </HBox>
                <VBox>
                    <Label text="Comentarios Generales" showColon="true" class="sectionLabel"/>
                    <TextArea width="100%"/>
                </VBox>
                <VBox>
                    <Label text="Indisponibilidades consecuentes cargadas" showColon="true" class="sectionLabel"/>
                    <Table id="myTable" inset="false">
                        <columns>
                            <Column><Text text="Equipo CAMMESA"/></Column>
                            <Column><Text text="F/S desde"/></Column>
                            <Column><Text text="Indisponible desde"/></Column>
                            <Column><Text text="E/S desde"/></Column>
                            <Column><Text text="Disponible desde"/></Column>
                            <Column><Text text="Comentarios"/></Column>
                            <Column><Text text="Se informa a CAMMESA"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{equipo}"/>
                                    <Text text="{fsDesde}"/>
                                    <Text text="{indisponibleDesde}"/>
                                    <Text text="{esDesde}"/>
                                    <Text text="{disponibleDesde}"/>
                                    <Text text="{comentarios}"/>
                                    <Text text="{seInformo}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
            </VBox>
        </VBox>

    </FlexBox>

</core:FragmentDefinition>
