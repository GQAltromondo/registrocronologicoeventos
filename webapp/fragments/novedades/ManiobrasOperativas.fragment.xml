<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

    <FlexBox direction="Column" class="sapUiSmallMargin">

        <!-- Seccion: Maniobras Operativas -->
        <VBox class="border_ctn sapUiSmallMarginBottom">
            <HBox class="sectionHeader" alignItems="Center">
                <core:Icon src="sap-icon://action-settings" class="sapUiSmallMarginEnd" color="#004da4"/>
                <Title text="Maniobras Operativas" level="H5"/>
            </HBox>
            <VBox class="container">
        
                <IconTabBar expandable="false" backgroundDesign="Transparent" headerBackgroundDesign="Transparent">
                    <items>
                        <IconTabFilter text="Cambio de barra" showAll="true">
                            <VBox class="container">
                                <VBox>
                                    <Label text="Se pasan los siguientes campos" class="sectionLabel"/>
                                    <TextArea width="100%"/>
                                </VBox>
                                <HBox justifyContent="Start">
                                    <VBox class="sapUiMediumMarginEnd">
                                        <Label text="De Barra" class="sectionLabel"/>
                                        <ComboBox/>
                                    </VBox>
                                    <VBox>
                                        <Label text="A Barra" class="sectionLabel"/>
                                        <ComboBox/>
                                    </VBox>
                                </HBox>
                                <VBox>
                                    <Label text="Fallo de equipo durante la maniobra" class="sectionLabel"/>
                                    <ComboBox/>
                                </VBox>
                                <VBox>
                                    <Label text="Comentarios" showColon="true" class="sectionLabel"/>
                                    <TextArea width="100%"/>
                                </VBox>
                                <HBox justifyContent="Start">
                                    <VBox class="sapUiMediumMarginEnd">
                                        <Label text="Se Informo a Personal" showColon="true" class="sectionLabel"/>
                                        <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Tplnr}" items="{ path: 'EstacionesJsonModel>/Estaciones', templateShareable: true }">
                                            <core:Item key="{EstacionesJsonModel>Estacion}" text="{path: 'EstacionesJsonModel>Descripcion'}"/>
                                        </ComboBox>
                                    </VBox>
                                    <VBox>
                                        <Label text="Se Informo a Empresa" showColon="true" class="sectionLabel"/>
                                        <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Tplnr}" items="{ path: 'EstacionesJsonModel>/Estaciones', templateShareable: true }">
                                            <core:Item key="{EstacionesJsonModel>Estacion}" text="{path: 'EstacionesJsonModel>Descripcion'}"/>
                                        </ComboBox>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>
        </VBox>

        <!-- Seccion: Normalizacion de la Instalacion -->
        <VBox class="border_ctn sapUiSmallMarginBottom">
            <HBox class="sectionHeader" alignItems="Center">
                <core:Icon src="sap-icon://restart" class="sapUiSmallMarginEnd" color="#004da4"/>
                <Title text="Normalizacion de la Instalacion" level="H5"/>
            </HBox>
            <VBox class="container">
                <HBox justifyContent="Start" alignItems="End">
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Fecha/Hora" showColon="true" class="sectionLabel"/>
                        <DatePicker/>
                    </VBox>
                    <HBox alignItems="Center">
                        <Label text="Se Normaliza configuracion" showColon="true" class="sectionLabel sapUiSmallMarginEnd"/>
                        <RadioButton text="SI" groupName="normConfig"/>
                        <RadioButton text="NO" groupName="normConfig"/>
                    </HBox>
                </HBox>
                <VBox>
                    <Label text="Fallo de equipo durante la maniobra" class="sectionLabel"/>
                    <ComboBox/>
                </VBox>
                <HBox justifyContent="Start">
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Se Informo a Personal" showColon="true" class="sectionLabel"/>
                        <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Tplnr}" items="{ path: 'EstacionesJsonModel>/Estaciones', templateShareable: true }">
                            <core:Item key="{EstacionesJsonModel>Estacion}" text="{path: 'EstacionesJsonModel>Descripcion'}"/>
                        </ComboBox>
                    </VBox>
                    <VBox>
                        <Label text="Se Informo a Empresa" showColon="true" class="sectionLabel"/>
                        <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Tplnr}" items="{ path: 'EstacionesJsonModel>/Estaciones', templateShareable: true }">
                            <core:Item key="{EstacionesJsonModel>Estacion}" text="{path: 'EstacionesJsonModel>Descripcion'}"/>
                        </ComboBox>
                    </VBox>
                </HBox>
                <VBox>
                    <Label text="Comentarios referente a la normalizacion" showColon="true" class="sectionLabel"/>
                    <TextArea width="100%"/>
                </VBox>
            </VBox>
        </VBox>

    </FlexBox>

</core:FragmentDefinition>
