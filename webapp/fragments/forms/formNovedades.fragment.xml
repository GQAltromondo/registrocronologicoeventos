<core:FragmentDefinition xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core" width="50%">
    <Dialog id="formNovedades" title="Novedades" titleAlignment="Start">
        <content>

            <FlexBox class="sapUiSmallMargin containerDialog" direction="Column">
                <HBox width="100%">
                    <HBox width="100%" class="sapUiSmallMarginBotton mainFrame FlexForm">
                        <VBox width="50%">
                            <HBox justifyContent="Start" alignItems="Center">
                                <Label text="Tipo de Novedad" class="sapUiSmallMarginEnd labels" />
                                <HBox>
                                    <ComboBox width="90px" selectionChange=".onNovedadSelected" selectedKey="{NovedadesFormJsonModel>/CodNovedad}" items="{ path: 'Novedades>/novs', templateShareable: true }">
                                        <core:Item key="{Novedades>Codigo}" text="{Novedades>Codigo}" />
                                    </ComboBox>
                                    <ComboBox width="300px" selectionChange=".onNovedadSelected" selectedKey="{NovedadesFormJsonModel>/CodNovedad}" items="{ path: 'Novedades>/novs', templateShareable: true }">
                                        <core:Item key="{Novedades>Codigo}" text="{Novedades>Descripcion}" />
                                    </ComboBox>
                                </HBox>
                            </HBox>
                            <HBox justifyContent="Start" alignItems="Center">
                                <Label text="Ubicacion" showColon="true" class="sapUiSmallMarginEnd labels" />
                                <HBox>
                                    <ComboBox width="90px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Tplnr}" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }">
                                        <core:Item key="{Estaciones>Codigo}" text="{path: 'Estaciones>Codigo'}" />
                                    </ComboBox>
                                    <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/Tplnr}" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }">
                                        <core:Item key="{Estaciones>Codigo}" text="{path: 'Estaciones>Descripcion'}" />
                                    </ComboBox>
                                </HBox>
                            </HBox>
                            <HBox justifyContent="Start" alignItems="Center">
                                <Label text="Equipo" class="sapUiSmallMarginEnd labels" showColon="true" />
                                <HBox>
                                    <ComboBox width="90px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/CodTipo}" items="{ path: 'TipoModel>/Tipo', templateShareable: true }">
                                        <core:Item key="{TipoModel>Tipo}" text="{TipoModel>Tipo}" />
                                    </ComboBox>
                                    <ComboBox width="300px" selectionChange=".onSelectionChange" selectedKey="{NovedadesFormJsonModel>/CodTipo}" items="{ path: 'TipoModel>/Tipo', templateShareable: true }">
                                        <core:ListItem key="{TipoModel>Tipo}" text="{TipoModel>Descripcion}" />
                                    </ComboBox>
                                </HBox>
                            </HBox>
                        </VBox>
                        <VBox width="50%">
                            <HBox width="100%" alignItems="Center" justifyContent="Start">
                                <Label text="Referencia" class="sapUiSmallMarginEnd labels" />
                                <Input  value="{NovedadesFormJsonModel>/IdNovedad}" enabled="false" width="250px" />
                            </HBox>
                            <HBox justifyContent="Start" alignItems="Center">
                                <Label text="Fecha/Hora" class="sapUiSmallMarginEnd labels" showColon="true" />
                                <DateTimePicker value="{ 'path': 'NovedadesFormJsonModel>/InicioNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }" />
                            </HBox>
                            <ComboBox id="noveltyComboBox" change="onComboBoxChange">
                                <core:Item key="Alarma" text="Alarma" />
                                <core:Item key="CargaDeEquipos" text="Carga de Equipos" />
                                <core:Item key="VinculadoSinTension" text="Vinculado y sin tensión" />
                                <core:Item key="EnBandaFueraDeBanda" text="En Banda o Fuera de Banda" />
                                <core:Item key="IndisponibilidadesSubindice" text="Indisponibilidades Subíndice" />
                                <core:Item key="ManiobrasOperativas1" text="Maniobras Operativas" />
                                <core:Item key="ManiobrasOperativas2" text="Maniobras Operativas 2" />
                                <core:Item key="ManiobrasOperativas3" text="Maniobras Operativas 3" />
                                <core:Item key="PantallaGeneral" text="Pantalla General" />
                            </ComboBox>
                        </VBox>
                    </HBox>
                </HBox>

            </FlexBox>
        </content>
        <beginButton>
            <Button text="Guardar" press="onSaveNovedad"/>
        </beginButton>
        <endButton>
            <Button text="Cerrar" press="onCloseDialog"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>