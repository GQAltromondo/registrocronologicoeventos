<core:FragmentDefinition xmlns="sap.m"
	xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table">
	<t:Table id="tableProgramadas" rows="{ path: 'oTProgramadasModel>/data', sorter: { path: 'FhFormat', descending: true }}" selectionMode="None" alternateRowColors="true">
		<t:columns>
			<!--	<t:Column width="50px">-->
			<!--	<Label/>-->
			<!--	<t:template>-->
			<!--		<HBox >-->
			<!--			<Button type="Transparent" press="onSee" icon="sap-icon://show"/>-->
			<!--		</HBox>-->
			<!--	</t:template>-->
			<!--</t:Column>-->
			<t:Column width='200px'>
				<Label text="{i18n>fromDate}"/>
				<t:template>
					<!--<Text text="{parts: [{path: 'oNovedadesModel>InicioNove'}], formatter: '.formatter.formatDateWithoutGMT'}"/>-->
					<DateTimePicker change="handleTableChanges" value="{ 'path': 'oTProgramadasModel>InicioNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
				</t:template>
			</t:Column>
			<t:Column width='200px'>
				<Label text="{i18n>toDate}"/>
				<t:template>
					<!--<Text text="{parts: [{path: 'oNovedadesModel>FechaFinNove'}], formatter: '.formatter.formatDateWithoutGMT'}"/>-->
					<DateTimePicker change="handleTableChanges" value="{ 'path': 'oTProgramadasModel>FechaFinNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
				</t:template>
			</t:Column>
		<t:Column width='200px'>
				<Label text="{i18n>place}"/>
				<t:template>
					<ComboBox selectionChange="onTableLugarChange" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }" selectedKey="{oTProgramadasModel>Tplnr}">
						<core:Item key="{Estaciones>Codigo}" text="{Estaciones>Codigo}"/>
					</ComboBox>
				</t:template>
			</t:Column>
			<t:Column width='150px'>
				<Label text="{i18n>team}"/>
				<t:template>
					<HBox>
						<Text text="{oTProgramadasModel>Equnr}" visible="{= !${oTProgramadasModel>__lugarChanged}}"/>
						<ComboBox selectionChange="handleTableChanges"
							items="{ path: 'oTProgramadasModel>__equipos', templateShareable: false }"
							selectedKey="{oTProgramadasModel>Equnr}"
							visible="{= !!${oTProgramadasModel>__lugarChanged}}">
							<core:Item key="{oTProgramadasModel>CodigoEquipo}" text="{oTProgramadasModel>CodigoEquipo} - {oTProgramadasModel>DescEquipo}"/>
						</ComboBox>
					</HBox>
				</t:template>
			</t:Column>
			<t:Column width='150px'>
				<Label text="{i18n>noveltyType}"/>
				<t:template>
					<Text text="{parts:[{path:'oTProgramadasModel>CodNovedad'}],formatter:'.formatter.novedadType'}"/>
				</t:template>
			</t:Column>
			<t:Column>
				<Label text="{i18n>novelty}"/>
				<t:template>
					<Text text="{oTProgramadasModel>IdNovedad}"/>
					<!-- <Text text="{oTProgramadasModel>CodUbFalla}"/> -->
				</t:template>
			</t:Column>
			<t:Column>
				<Label text="{i18n>operator}"/>
				<t:template>
					<Text text="{oTProgramadasModel>fromDate}"/>
				</t:template>
			</t:Column>
			<t:Column width="180px">
				<Label/>
				<t:template>
					<HBox justifyContent="SpaceAround" wrap="Wrap">
						<Button type="Transparent" press="onView" icon="sap-icon://show"/>
						<Button type="Transparent" press="saveChanges" enabled="false" icon="sap-icon://save" visible="{UserDataModel>/isEditor}"/>
						<Button type="Transparent" press="onSearchNovedad" icon="sap-icon://edit" visible="{UserDataModel>/isEditor}"/>
						<Button type="Transparent" press='onDelete' icon="sap-icon://delete" visible="{UserDataModel>/isEditor}"/>
					</HBox>
				</t:template>
			</t:Column>
		</t:columns>
	</t:Table>
</core:FragmentDefinition>