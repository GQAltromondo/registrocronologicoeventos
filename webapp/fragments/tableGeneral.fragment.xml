<core:FragmentDefinition xmlns="sap.m"
	xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table">
	<t:Table id="generalTable" rows="{ path: 'oFilteredModel>/data', sorter: { path: 'FhFormat', descending: true }}" selectionMode="None" alternateRowColors="true">
		<t:extension>
			<OverflowToolbar style="Clear">
				<ToolbarSpacer/>
				<ToolbarSeparator/>
				<Button icon="sap-icon://refresh" tooltip="Refrescar" press="clearAllFilters"/>
			</OverflowToolbar>
		</t:extension>

		<t:Column width='200px'>
			<Label text="{i18n>fromDate}"/>
			<t:template>
				<!--<Text text="{parts: [{path: 'oFilteredModel>InicioNove'}], formatter: '.formatter.formatDateWithoutGMT'}"/>-->
				<DateTimePicker change="handleTableChanges" value="{ 'path': 'oFilteredModel>InicioNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
			</t:template>
		</t:Column>
		<t:Column width='200px'>
			<Label text="{i18n>toDate}"/>
			<t:template>
				<!--<Text text="{parts: [{path: 'oFilteredModel>FechaFinNove'}], formatter: '.formatter.formatDateWithoutGMT'}"/>-->
				<DateTimePicker change="handleTableChanges" value="{ 'path': 'oFilteredModel>FechaFinNove', 'type': 'sap.ui.model.type.DateTime', 'formatOptions': { 'pattern': 'dd/MM/yyyy H:mm' } }"/>
			</t:template>
		</t:Column>
		<t:Column>
			<Label text="{i18n>place}"/>
			<t:template>
				<!--<Text text="{oFilteredModel>Tplnr}"/>-->
				<ComboBox selectionChange="handleTableChanges" items="{ path: 'Estaciones>/Estaciones', templateShareable: true }" selectedKey="{oFilteredModel>Tplnr}">
					<core:Item key="{Estaciones>Codigo}" text="{Estaciones>Codigo}"/>
				</ComboBox>
			</t:template>
		</t:Column>
		<t:Column>
			<Label text="{i18n>team}"/>
			<t:template>
				<Text text="{oFilteredModel>Equnr}"/>
			</t:template>
		</t:Column>
		<t:Column>
			<Label text="{i18n>noveltyType}"/>
			<t:template>
				<Text text="{parts:[{path:'oFilteredModel>CodNovedad'}],formatter:'.formatter.novedadType'}"/>
			</t:template>
		</t:Column>
		<t:Column>
			<Label text="{i18n>novelty}"/>
			<t:template>
				<Text text="{oFilteredModel>CodUbFalla}"/>
			</t:template>
		</t:Column>
		<t:Column>
			<Label text="{i18n>operator}"/>
			<t:template>
				<Text text="{oFilteredModel>fromDate}"/>
			</t:template>
		</t:Column>
		<t:Column width="180px">
			<Label/>
			<t:template>
				<HBox justifyContent="SpaceAround" wrap="Wrap">
					<Button type="Transparent" press="onSee" icon="sap-icon://show"/>
					<Button type="Transparent" press="saveChanges" enabled="false" icon="sap-icon://save"/>
					<Button type="Transparent" press="onEditNove" icon="sap-icon://edit"/>
					<Button type="Transparent" press='onDelete' icon="sap-icon://delete"/>
				</HBox>
			</t:template>
		</t:Column>
	</t:Table>
</core:FragmentDefinition>